---
import { getUi } from '../data/i18n';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const trust = getUi(locale).trust;
---

<section class="trust-bar shell" aria-label="Warzone Cheats package status">
	<div class="trust-bar__panel">
		<div class="trust-bar__grid">
			<article class="trust-bar__card">
				<div class="trust-bar__icon trust-bar__icon--status" aria-hidden="true">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none">
						<circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.6"></circle>
						<path
							d="M8.5 12.2l2.4 2.4 4.8-5"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</div>
				<div class="trust-bar__body">
					<p class="trust-bar__label">Status</p>
					<p class="trust-bar__value trust-bar__value--full">{trust.status} — {trust.statusNote}</p>
					<p class="trust-bar__value trust-bar__value--short">{trust.status} · {trust.statusShort}</p>
				</div>
			</article>

			<article class="trust-bar__card">
				<div class="trust-bar__icon trust-bar__icon--delivery" aria-hidden="true">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none">
						<path
							d="M3 7.5h11v8H3V7.5zM14 10h3.2l2.8 3v2.5H14V10z"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linejoin="round"></path>
						<circle cx="7" cy="17.5" r="1.5" fill="currentColor"></circle>
						<circle cx="17.5" cy="17.5" r="1.5" fill="currentColor"></circle>
					</svg>
				</div>
				<div class="trust-bar__body">
					<p class="trust-bar__label">Delivery</p>
					<p class="trust-bar__value">{trust.delivery}</p>
				</div>
			</article>

			<article class="trust-bar__card">
				<div class="trust-bar__icon trust-bar__icon--platform" aria-hidden="true">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none">
						<rect x="3.5" y="4.5" width="17" height="12" rx="1.5" stroke="currentColor" stroke-width="1.6"
						></rect>
						<path d="M8.5 20h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
					</svg>
				</div>
				<div class="trust-bar__body">
					<p class="trust-bar__label">Platform</p>
					<p class="trust-bar__value">{trust.platform}</p>
				</div>
			</article>

			<article class="trust-bar__card">
				<div class="trust-bar__icon trust-bar__icon--shield" aria-hidden="true">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none">
						<path
							d="M12 3.5l7 3v5.5c0 4.2-2.8 7.8-7 9.5-4.2-1.7-7-5.3-7-9.5V6.5l7-3z"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linejoin="round"></path>
						<path
							d="M9.2 12.1l1.8 1.8 3.8-4"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</div>
				<div class="trust-bar__body">
					<p class="trust-bar__label">Anti-cheat</p>
					<p class="trust-bar__value trust-bar__value--full">{trust.antiCheat}</p>
					<p class="trust-bar__value trust-bar__value--short">{trust.antiCheatShort}</p>
				</div>
			</article>
		</div>
	</div>
</section>

<style>
	.trust-bar {
		padding-block: 0.65rem 0.85rem;
		min-height: 7.5rem;
		content-visibility: auto;
		contain-intrinsic-size: 1px 140px;
	}

	.trust-bar__panel {
		padding: 0.65rem;
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border);
		background: linear-gradient(180deg, rgba(34, 28, 48, 0.88) 0%, rgba(18, 16, 26, 0.95) 100%);
		box-shadow: var(--shadow-soft);
		min-height: 6.75rem;
	}

	@media (min-width: 761px) and (prefers-reduced-motion: no-preference) {
		.trust-bar__panel {
			animation: trust-in 0.65s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
		}
	}

	.trust-bar__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.5rem;
	}

	.trust-bar__card {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		min-width: 0;
		padding: 0.85rem 0.95rem;
		border-radius: 0.95rem;
		border: 1px solid rgba(168, 85, 247, 0.1);
		background: rgba(26, 22, 38, 0.55);
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.trust-bar__card:hover {
		border-color: rgba(192, 132, 252, 0.22);
		background: rgba(34, 28, 48, 0.72);
	}

	.trust-bar__icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.65rem;
		border: 1px solid rgba(192, 132, 252, 0.2);
		background: rgba(124, 58, 237, 0.12);
		color: var(--color-orchid);
	}

	.trust-bar__icon--status {
		color: #86efac;
	}

	.trust-bar__icon--delivery {
		color: #c4b5fd;
	}

	.trust-bar__icon--platform {
		color: #e9d5ff;
	}

	.trust-bar__icon--shield {
		color: #a78bfa;
	}

	.trust-bar__body {
		min-width: 0;
		flex: 1;
	}

	.trust-bar__label {
		margin: 0;
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.11em;
		text-transform: uppercase;
		color: var(--color-faint);
	}

	.trust-bar__value {
		margin: 0.35rem 0 0;
		font-size: 0.88rem;
		font-weight: 600;
		line-height: 1.45;
		color: var(--color-ink);
		overflow-wrap: anywhere;
	}

	.trust-bar__value--short {
		display: none;
	}

	@keyframes trust-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 960px) {
		.trust-bar__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 520px) {
		.trust-bar {
			padding-block: 0.5rem 0.65rem;
		}

		.trust-bar__panel {
			padding: 0.5rem;
			border-radius: 1rem;
		}

		.trust-bar__grid {
			grid-template-columns: 1fr 1fr;
			gap: 0.4rem;
		}

		.trust-bar__card {
			flex-direction: column;
			gap: 0.55rem;
			padding: 0.7rem 0.75rem;
		}

		.trust-bar__icon {
			width: 2rem;
			height: 2rem;
		}

		.trust-bar__value {
			font-size: 0.8rem;
		}

		.trust-bar__value--full {
			display: none;
		}

		.trust-bar__value--short {
			display: block;
		}
	}
</style>
