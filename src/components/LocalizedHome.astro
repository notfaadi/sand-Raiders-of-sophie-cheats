---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import HomePitch from '../components/HomePitch.astro';
import HomeReviews from '../components/HomeReviews.astro';
import HomeSeo from '../components/HomeSeo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocaleContent, getPageContent } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { homeFaqs, homeSeo, siteConfig } from '../data/site';
import { warzoneImages } from '../data/warzone';
import { heroPreloadSrc, heroSizes } from '../lib/responsive-images';
import { productSoftwareGraph } from '../data/schema-product';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const { ui } = getLocaleContent(locale);
const home = getPageContent(locale, 'home');
const enHome = homeSeo();

const title = locale === 'en' ? enHome.title : home.title;
const description = locale === 'en' ? enHome.description : home.description;
const canonicalPath = getLocalizedPath('home', locale);
const canonicalURL = new URL(canonicalPath, siteConfig.url).href;
const heroImage = new URL(siteConfig.heroImage || warzoneImages.hero, siteConfig.url).href;

const extraGraph: Record<string, unknown>[] = [
	...productSoftwareGraph({
		pageUrl: canonicalURL,
		image: heroImage,
		includeReviews: true,
		includeOffers: true,
	}),
	{
		'@type': 'FAQPage',
		'@id': `${canonicalURL}#faq`,
		mainEntity: homeFaqs.map((item) => ({
			'@type': 'Question',
			name: item.question,
			url: `${siteConfig.url}/faq/${item.slug}/`,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
];
---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={home.imageAlt}
	locale={locale}
	pageId="home"
	breadcrumbs={[{ label: ui.nav.home }]}
	extraGraph={locale === 'en' ? extraGraph : extraGraph.filter((n) => n['@type'] !== 'FAQPage')}
	lcpImage={heroPreloadSrc}
	lcpImageSizes={heroSizes}
>
	<Navbar locale={locale} pageId="home" />
	<main class="home">
		<Hero locale={locale} />
		<TrustStrip locale={locale} />
		{locale === 'en' && <HomePitch />}
		<HomeReviews />
		<div class="home__seo">
			{
				locale === 'en' ? (
					<HomeSeo />
				) : (
					<div class="shell home__prose">
						<h2>{home.h1}</h2>
						<p>{home.intro}</p>
						{
							home.sections.map((section) => (
								<div>
									<h3>{section.h2}</h3>
									{section.paragraphs.map((p) => (
										<p set:html={p} />
									))}
								</div>
							))
						}
					</div>
				)
			}
		</div>
		<SiteFooter locale={locale} />
	</main>
</Layout>

<style>
	.home {
		width: 100%;
		overflow-x: clip;
	}

	.home__seo {
		border-top: 1px solid var(--line-soft);
		background: var(--bg-panel);
	}

	.home__prose {
		padding-block: var(--section-space);
		color: var(--ink-muted);
		line-height: 1.65;
		font-size: 0.9375rem;
	}

	.home__prose h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: 1.5rem;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.home__prose h3 {
		margin: 1.25rem 0 0.5rem;
		font-size: 1rem;
		color: var(--ink);
	}
</style>
