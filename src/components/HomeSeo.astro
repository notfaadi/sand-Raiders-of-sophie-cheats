		left: 0.75rem;
		top: 50%;
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 999px;
		background: var(--color-orchid);
		transform: translateY(-50%);
	}

	.home-seo a {
		color: var(--color-orchid);
		font-weight: 600;
	}

	.home-seo a:hover {
		color: var(--color-ink);
	}

	.home-seo__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem;
		margin-top: 1.25rem;
	}

	.home-seo__grid article {
		padding: 1rem;
		border-radius: 0.9rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(10, 6, 18, 0.35);
	}

	.home-seo__grid h3 {
