---
import { fillBrandTokens } from '../data/brand';
import { brandCopy, productInfo, siteConfig } from '../data/site-core';

const ctaBuy = fillBrandTokens(brandCopy.ctaBuy);
const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];

const whyPoints = [
	'Undetected builds maintained after Easy Anti-Cheat and game patches',
	'24/7 support for setup, delivery, and patch-day questions',
	'One license covers ESP, aimbot, wallhack, and radar on Windows PC',
];

const featurePoints = [
	{ label: 'ESP', text: 'Player boxes, distance, and loot markers through walls.' },
	{ label: 'Aimbot', text: 'Soft aim you can tune for natural fights.' },
	{ label: 'Wallhack', text: 'Clear reads before you push a room or extract.' },
	{ label: 'Radar', text: '2D map cues so flanks and third parties show early.' },
	{
		label: 'Cloud DMA',
		text: 'Remote path for a safer setup than kernel-only alone.',
		href: '/cloud-dma/',
	},
];

const securityPoints = [
	'We do not ask for your game password or account login.',
	'Licenses ship digitally after checkout — keep your order ID for support.',
	'No cheat is risk-free forever. Check Status before you play after a patch.',
	'Responsible settings and staying on the current build matter as much as features.',
];

const updatePoints = [
	'We watch SAND: Raiders of Sophie and Easy Anti-Cheat releases and rebuild when modules need it.',
	'Status posts go up when a patch affects sand raiders of sophie cheats — check before you queue.',
	'Active licenses get the rebuilt package when maintenance is live.',
	'Compatible with the latest game client builds we list as Online on Status.',
];
---

<section class="pitch" aria-labelledby="pitch-why-title">
	<div class="shell pitch__stack">
		<article class="pitch__block">
			<p class="pitch__eyebrow">Why Sandraiders</p>
			<h2 id="pitch-why-title">Undetected sandraiders cheats with 24/7 support</h2>
			<p class="pitch__lede">
				{siteConfig.name} is built for players who want sand raiders of sophie cheats that stay
				maintained — not a one-week crack. Undetected status plus real support when you need setup help.
			</p>
			<ul class="pitch__list">
				{whyPoints.map((item) => <li>{item}</li>)}
			</ul>
		</article>

		<article class="pitch__block" aria-labelledby="pitch-features-title">
			<p class="pitch__eyebrow">Features</p>
			<h2 id="pitch-features-title">ESP, aimbot, wallhack, and radar</h2>
			<p class="pitch__lede">
				Everything you need in one sandraiders cheats license for Windows PC — ready for SAND: Raiders
				of Sophie.
			</p>
			<ul class="pitch__features">
				{
					featurePoints.map((item) => (
						<li>
							{'href' in item && item.href ? (
								<a href={item.href}>
									<strong>{item.label}</strong>
									<span>{item.text}</span>
								</a>
							) : (
								<>
									<strong>{item.label}</strong>
									<span>{item.text}</span>
								</>
							)}
						</li>
					))
				}
			</ul>
			<p class="pitch__link">
				<a href="/features/">Full feature list →</a>
			</p>
		</article>

		<article class="pitch__block" aria-labelledby="pitch-security-title">
			<p class="pitch__eyebrow">Account safety</p>
			<h2 id="pitch-security-title">Security concerns, answered clearly</h2>
			<p class="pitch__lede">
				Buyers ask the same questions about sand raiders hacks and account risk. Here is the straight
				marketing answer — no exploit steps, just how we handle delivery and status.
			</p>
			<ul class="pitch__list">
				{securityPoints.map((item) => <li>{item}</li>)}
			</ul>
		</article>

		<article class="pitch__block" aria-labelledby="pitch-updates-title">
			<p class="pitch__eyebrow">Updates</p>
			<h2 id="pitch-updates-title">Patch compatibility</h2>
			<p class="pitch__lede">
				When SAND: Raiders of Sophie or Easy Anti-Cheat ships a patch, we test and rebuild. Update
				frequency follows the game — not a fixed calendar — so you stay on a current build.
			</p>
			<ul class="pitch__list">
				{updatePoints.map((item) => <li>{item}</li>)}
			</ul>
			<p class="pitch__link">
				<a href="/updates/">Check live status →</a>
			</p>
		</article>

		<aside class="pitch__cta" aria-labelledby="pitch-cta-title">
			<div class="pitch__cta-copy">
				<p class="pitch__eyebrow">Ready</p>
				<h2 id="pitch-cta-title">Buy sandraiders cheats now</h2>
				<p>
					Instant delivery after payment. Undetected package with ESP, aimbot, and radar — plus 24/7
					support when you need it.
				</p>
			</div>
			<a class="pitch__buy" href={siteConfig.checkoutUrl} rel="noopener noreferrer">
				<span data-edit="ctaBuy">{ctaBuy}</span>
				<span class="pitch__buy-price">from ${monthly.price}</span>
			</a>
		</aside>
	</div>
</section>

<style>
	.pitch {
		padding-block: clamp(2.75rem, 5vw, 4rem);
		border-top: 1px solid var(--line-soft);
		background: var(--bg);
	}

	.pitch__stack {
		display: grid;
		gap: clamp(2rem, 4vw, 2.75rem);
	}

	.pitch__block {
		max-width: 40rem;
	}

	.pitch__eyebrow {
		margin: 0 0 0.4rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.pitch__block h2,
	.pitch__cta h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: var(--ink);
	}

	.pitch__lede,
	.pitch__cta p {
		margin: 0.55rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.pitch__list {
		margin: 0.9rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.55rem;
	}

	.pitch__list li {
		position: relative;
		padding-left: 1.15rem;
		font-size: 0.9rem;
		line-height: 1.45;
		color: var(--ink-muted);
	}

	.pitch__list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: var(--magenta-soft);
		box-shadow: 0 0 10px color-mix(in srgb, var(--magenta) 45%, transparent);
	}

	.pitch__features {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.pitch__features li {
		display: grid;
		gap: 0.25rem;
		padding: 0.85rem 0.95rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.pitch__features li:hover,
	.pitch__features li:focus-within {
		border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--accent) 22%, transparent),
			0 0 18px var(--glow-soft),
			0 0 36px color-mix(in srgb, var(--magenta) 22%, transparent);
	}

	.pitch__features a {
		display: grid;
		gap: 0.25rem;
		margin: -0.85rem -0.95rem;
		padding: 0.85rem 0.95rem;
		border-radius: inherit;
		text-decoration: none;
		color: inherit;
		outline: none;
	}

	.pitch__features strong {
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--ink);
	}

	.pitch__features span {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--ink-muted);
	}

	.pitch__link {
		margin: 0.85rem 0 0;
	}

	.pitch__link a {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--magenta-soft);
	}

	.pitch__link a:hover {
		color: var(--ink);
	}

	.pitch__cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem 1.75rem;
		padding: clamp(1.25rem, 3vw, 1.65rem);
		border: 1px solid color-mix(in srgb, var(--magenta) 28%, var(--line));
		border-radius: var(--radius-lg, 1rem);
		background:
			radial-gradient(
				ellipse 70% 90% at 0% 50%,
				color-mix(in srgb, var(--magenta) 12%, transparent),
				transparent 55%
			),
			var(--bg-panel);
	}

	.pitch__cta-copy {
		min-width: 0;
		max-width: 32rem;
	}

	.pitch__buy {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		flex-shrink: 0;
		min-height: 3rem;
		padding: 0.55rem 0.55rem 0.55rem 1.05rem;
		border-radius: 999px;
		background: var(--magenta);
		color: var(--bg);
		font-size: 0.9375rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		text-decoration: none;
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 35%, transparent) inset,
			0 0 18px color-mix(in srgb, var(--magenta) 35%, transparent),
			0 10px 28px rgba(0, 0, 0, 0.28);
		transition:
			transform 0.18s ease,
			background 0.18s ease,
			box-shadow 0.18s ease;
	}

	.pitch__buy-price {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		padding: 0 0.85rem;
		border-radius: 999px;
		background: var(--bg);
		color: var(--magenta-soft);
		font-size: 0.8125rem;
		font-weight: 700;
	}

	.pitch__buy:hover {
		background: var(--accent-hover);
		transform: translateY(-2px);
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 40%, transparent) inset,
			0 0 22px color-mix(in srgb, var(--magenta) 55%, transparent),
			0 14px 32px rgba(0, 0, 0, 0.34);
	}

	.pitch__buy:hover .pitch__buy-price {
		background: color-mix(in srgb, var(--magenta-deep) 55%, var(--bg));
		color: #fff;
	}

	@media (min-width: 761px) {
		.pitch__features {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.pitch__cta {
			flex-direction: column;
			align-items: stretch;
		}

		.pitch__buy {
			width: 100%;
			justify-content: space-between;
			min-height: var(--touch-min, 2.75rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pitch__features li {
			transition: none;
		}

		.pitch__buy,
		.pitch__buy:hover {
			transition: none;
			transform: none;
		}
	}
</style>
