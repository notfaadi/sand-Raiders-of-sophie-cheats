---
import { getUi, getPageContent } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getBlogBasePath } from '../data/blog/helpers';
import { siteConfig } from '../data/site';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const exploreLinks = [
	{ label: ui.nav.home, href: getLocalizedPath('home', locale) },
	{ label: getPageContent(locale, 'hacks').h1.split('—')[0].trim(), href: getLocalizedPath('hacks', locale) },
	{ label: ui.nav.esp, href: getLocalizedPath('warzone-esp', locale) },
	{ label: getPageContent(locale, 'best-cheats').h1.split('—')[0].trim(), href: getLocalizedPath('best-cheats', locale) },
	{ label: ui.nav.pricing, href: getLocalizedPath('pricing', locale) },
	{ label: ui.nav.faq, href: getLocalizedPath('faq', locale) },
	{ label: 'Blog', href: getBlogBasePath(locale) },
];

const helpLinks = [
	{ label: ui.nav.updates, href: getLocalizedPath('updates', locale) },
	{ label: getPageContent(locale, 'support').h1.split('—')[0].trim(), href: getLocalizedPath('support', locale) },
	{ label: getPageContent(locale, 'refund').h1.split('—')[0].trim(), href: getLocalizedPath('refund', locale) },
	{ label: getPageContent(locale, 'privacy').h1.split('—')[0].trim(), href: getLocalizedPath('privacy', locale) },
	{ label: getPageContent(locale, 'terms').h1.split('—')[0].trim(), href: getLocalizedPath('terms', locale) },
];
---

<footer class="footer" id="support-footer">
	<div class="shell footer__inner">
		<div class="footer__brand">
			<p class="footer__name">{ui.product.title}</p>
			<p class="footer__text">
				{ui.footer.tagline.split('\n').map((line) => (
					<span class="footer__text-line">{line}</span>
				))}
			</p>
			<p class="footer__official">{ui.common.officialLanguageNote}</p>
		</div>
		<nav class="footer__cols" aria-label="Footer">
			<div class="footer__explore">
				<p class="footer__label">{ui.footer.explore}</p>
				<ul class="footer__explore-list">
					{exploreLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
				</ul>
			</div>
			<div>
				<p class="footer__label">{ui.footer.help}</p>
				<ul>
					{helpLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
					<li><a href={`mailto:${siteConfig.supportEmail}`}>Email support</a></li>
				</ul>
			</div>
		</nav>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid rgba(168, 85, 247, 0.12);
		padding-block: 1.25rem;
		padding-bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
	}

	.footer__inner {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 1.25rem;
		align-items: start;
	}

	.footer__name {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 800;
		letter-spacing: 0.04em;
	}

	.footer__text {
		display: flex;
		flex-direction: column;
		gap: 0.12rem;
		margin: 0.45rem 0 0;
		color: var(--color-faint);
		font-size: 0.88rem;
		line-height: 1.35;
		max-width: 20rem;
	}

	.footer__text-line {
		display: block;
	}

	.footer__official {
		margin: 0.35rem 0 0;
		color: var(--color-orchid);
		font-size: 0.72rem;
		line-height: 1.3;
		max-width: 20rem;
	}

	.footer__cols {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
		gap: 1rem;
	}

	.footer__label {
		margin: 0 0 0.4rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-orchid);
	}

	.footer ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.35rem;
	}

	.footer__explore-list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: 0.65rem;
		row-gap: 0.2rem;
	}

	.footer__explore-list li {
		display: inline-flex;
	}

	.footer__explore-list a {
		font-size: 0.8rem;
		line-height: 1.25;
		white-space: nowrap;
	}

	.footer a {
		color: var(--color-muted);
		font-size: 0.85rem;
		font-weight: 600;
	}

	.footer a:hover {
		color: var(--color-ink);
	}

	@media (max-width: 760px) {
		.footer {
			padding-block: 1.1rem;
		}

		.footer__inner {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.footer__cols {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 480px) {
		.footer__cols {
			grid-template-columns: 1fr;
			gap: 0.85rem;
		}

		.footer__explore-list {
			column-gap: 0.5rem;
		}

		.footer__explore-list a {
			font-size: 0.78rem;
		}
	}
</style>
