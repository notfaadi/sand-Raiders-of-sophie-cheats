---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteConfig } from '../data/site';

const title = 'Page Not Found | Warzone Hacks';
const description =
	'That Warzone Hacks page is missing. Return home or browse ESP, Aimbot, pricing, setup, reviews, and the Warzone Intel blog.';
---

<Layout title={title} description={description} canonicalPath="/" noindex={true}>
	<Navbar />
	<main class="missing">
		<div class="shell missing__inner">
			<p class="missing__code">404</p>
			<h1 class="missing__title">Page not found</h1>
			<p class="missing__text">
				The URL you opened is not on {siteConfig.name}. Use the links below to continue comparing ESP,
				Aimbot, pricing, and setup for Call of Duty: Warzone on Windows PC.
			</p>
			<div class="missing__actions">
				<a class="btn-buy" href="/">Back to Warzone Hacks home</a>
				<a class="missing__ghost" href="/warzone-hacks/">Call of Duty: Warzone hacks guide</a>
				<a class="missing__ghost" href="/pricing/">Pricing</a>
				<a class="missing__ghost" href="/reviews/">Reviews</a>
				<a class="missing__ghost" href="/blog/">Blog</a>
				<a class="missing__ghost" href="/support/">Support</a>
			</div>
		</div>
	</main>
	<SiteFooter />
</Layout>

<style>
	.missing {
		min-height: 58vh;
		display: grid;
		align-items: center;
		padding-block: clamp(2.5rem, 8vw, 5rem);
	}

	.missing__inner {
		max-width: 40rem;
		display: grid;
		gap: 0.85rem;
	}

	.missing__code {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 8vw, 4rem);
		font-weight: 800;
		letter-spacing: 0.04em;
		color: rgba(192, 132, 252, 0.55);
		line-height: 1;
	}

	.missing__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 4vw, 2.2rem);
		font-weight: 800;
	}

	.missing__text {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.65;
		max-width: 36rem;
	}

	.missing__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 0.75rem;
	}

	.missing__ghost {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.55rem 0.95rem;
		border-radius: 0.7rem;
		border: 1px solid rgba(192, 132, 252, 0.25);
		background: rgba(34, 28, 48, 0.85);
		color: var(--color-ink);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}

	.missing__ghost:hover {
		border-color: rgba(192, 132, 252, 0.5);
	}

	@media (max-width: 720px) {
		.missing__actions {
			flex-direction: column;
		}

		.missing__ghost,
		.missing__actions :global(.btn-buy) {
			width: 100%;
		}
	}
</style>
