{
	"name": "warzone-hacks",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:validate": "astro build && node scripts/validate-sitemaps.mjs",
    "optimize:images": "node scripts/optimize-responsive-images.mjs",
    "fetch:images": "node scripts/fetch-warzone-images.mjs",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "preview": "astro preview",
    "validate:sitemaps": "node scripts/validate-sitemaps.mjs",
    "generate:i18n": "node scripts/generate-i18n-content.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=warzonehacks",
    "pages:deploy": "wrangler pages deploy dist --project-name=warzonehacks",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource-variable/syne": "^5.2.7",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "terser": "^5.49.0",
    "wrangler": "^4.30.0"
  }
}
